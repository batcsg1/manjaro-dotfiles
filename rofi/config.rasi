configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Window";
    drun-display-format: "{name}";
    font: "Iosevka Nerd Font 12";
    sidebar-mode: false;
    hover-select: true;
    me-select-entry: "MousePrimary";
    me-accept-entry: "MouseDPrimary";
}

/* Neon Green — matches kitty / waybar / wofi / starship / btop */
* {
    base:     #0a0f0a;
    surface:  #0f1710;
    overlay:  #17261a;
    muted:    #2f4a35;
    subtle:   #6fa87a;
    text:     #c6f5ce;
    bright:   #f2fff4;
    neon:     #39ff14;
    lime:     #76ff3c;
    aqua:     #00ffc8;
    acid:     #d7ff1a;
    alert:    #ff2d55;

    background-color: transparent;
    text-color: @text;
}

window {
    background-color: @base;
    border: 2px;
    border-color: @neon;
    border-radius: 10px;
    padding: 12px;
    width: 500px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @overlay;
    text-color: @text;
    border-radius: 8px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @aqua;
}

entry {
    placeholder: "Search...";
    placeholder-color: @muted;
    text-color: @text;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @subtle;
    padding: 8px 10px;
    border-radius: 6px;
}

element selected {
    background-color: @overlay;
    text-color: @neon;
}

element urgent {
    text-color: @alert;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
