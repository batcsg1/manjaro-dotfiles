{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "manjaro",
        "padding": {
            "top": 1,
            "right": 4
        },
        "color": {
            "1": "38;2;57;255;20",
            "2": "38;2;0;255;200",
            "3": "38;2;10;191;83",
            "4": "38;2;118;255;60"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;57;255;20",
            "title": "1;38;2;57;255;20",
            "output": "38;2;198;245;206",
            "separator": "38;2;47;74;53"
        },
        "percent": {
            "type": 9
        },
        "bar": {
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "border": {
                "left": "[",
                "right": "]"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "1;38;2;57;255;20",
                "at": "38;2;47;74;53",
                "host": "1;38;2;118;255;60"
            }
        },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "38;2;47;74;53"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "38;2;10;191;83",
            "format": "{3} (Btw)"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "38;2;118;255;60"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "38;2;57;255;20"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "38;2;0;255;200"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "38;2;0;255;133"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "38;2;215;255;26"
        },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "38;2;47;74;53"
        },
        {
            "type": "host",
            "key": "󰇅 ",
            "keyColor": "38;2;10;191;83"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "38;2;118;255;60"
        },
        {
            "type": "gpu",
            "key": "󰢮 ",
            "keyColor": "38;2;57;255;20"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "38;2;0;255;200"
        },
        {
            "type": "disk",
            "key": "󰋊 ({mountpoint})",
            "keyColor": "38;2;0;255;133",
            "folders": "/:/home:/mnt/backups"
        },
        "break",
        {
            "type": "colors",
            "symbol": "block"
        }
    ]
}
