{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "fixed-center": true,
    "modules-left": ["custom/distro", "hyprland/workspaces", "temperature", "cpu", "memory", "disk"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "custom/netspeed", "custom/uptime", "battery"],
    // Neon Green palette
    // Void:   #0A0F0A #0F1710 #17261A #2F4A35
    // Haze:   #C6F5CE #DDFFE3 #F2FFF4
    // Neon:   #00FFC8 #39FF14 #76FF3C #0ABF53
    // Signal: #FF2D55 #FFB31A #D7FF1A #00FF85 #00E5A0

    "custom/distro": {
        "format": "󰣇 ",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "clock": {
        "interval": 1,
        "format": "{0:%I:%M:%S %p}  |  {0:%z}  |  {0:%a * %b}  |  {0:%Y-%m-%d}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "months":   "<span color='#39FF14'><b>{}</b></span>",
                "weekdays": "<span color='#76FF3C'><b>{}</b></span>",
                "today":    "<span color='#D7FF1A'><b><u>{}</u></b></span>"
            }
        }
    },

    "temperature": {
        "format": "  {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "  {temperatureC}°C",
        "tooltip": true
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": true
    },

    "memory": {
        "format": "󰍛  {percentage}%",
        "tooltip": true
    },

    "disk": {
        "format": "󰋊  {percentage_used}%",
        "path": "/"
    },

    "pulseaudio": {
        "format": "󰕾  {volume}%",
        "format-muted": "󰝟",
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "format-on": "󰂯 on",
        "format-off": "󰂲 off",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭"
    },

    "custom/netspeed": {
        "exec": "~/.config/waybar/scripts/netspeed.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },

    "custom/uptime": {
        "exec": "~/.config/waybar/scripts/uptime.sh",
        "return-type": "json",
        "interval": 60,
        "tooltip": true
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" }
    },

    "tray": {
        "spacing": 8
    }
}
